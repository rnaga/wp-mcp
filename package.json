{
  "name": "@rnaga/wp-mcp",
  "version": "1.0.6",
  "description": "WordPress Model Context Protocol (MCP) implementation",
  "mcpName": "io.github.rnaga/wp-mcp",
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "wordpress",
    "typescript",
    "node"
  ],
  "author": "Ryohei Nagatsuka",
  "license": "MIT",
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest",
    "build": "rm -rf ./dist && tsc && npm run copyfiles && npm run copy-http-template && rm -rf ./dist/_wp",
    "clean": "tsc --build --clean",
    "copyfiles": "copyfiles -u 1 \"src/**/*.d.ts\" dist",
    "copy-http-template": "rsync -avz --delete ./src/cli/templates/ dist/cli/templates/",
    "inspect": "export NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" && npx @modelcontextprotocol/inspector",
    "start:express": "npx ts-node src/http/index.ts",
    "wp-mcp:dev": "npx ts-node src/cli/index.ts",
    "wp-mcp": "node dist/cli/index.js",
    "sync-wp-node": "rsync -avz ../wp-node/packages/core/dist/ ./node_modules/\\@rnaga/wp-node/",
    "sync-wp-node-cli": "rsync -avz ../wp-node/packages/cli/dist/ ./node_modules/\\@rnaga/wp-node-cli/",
    "sync-http-template": "./scripts/sync-http-template.sh",
    "release": "./scripts/release.sh"
  },
  "dependencies": {
    "@keyv/sqlite": "^4.0.5",
    "@modelcontextprotocol/sdk": "^1.17.5",
    "@rnaga/wp-node": "^1",
    "@rnaga/wp-node-cli": "^1",
    "cache-manager": "^7.2.0",
    "commander": "^14.0.1",
    "cors": "^2.8.5",
    "enquirer": "^2.4.1",
    "express": "^5.1.0",
    "keyv": "^5.5.3",
    "node-fetch": "^3.3.2",
    "reflect-metadata": "^0.1.14",
    "zod": "^3.25.76"
  },
  "bin": {
    "wp-mcp": "./cli/index.js"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "copyfiles": "^2.4.1",
    "jest": "^30.1.3",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnaga/wp-mcp.git"
  },
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rnaga/wp-mcp/issues"
  },
  "homepage": "https://github.com/rnaga/wp-mcp"
}
